{
  "name": "inkmark",
  "productName": "Inkmark",
  "version": "0.2.0",
  "private": true,
  "description": "A Typora-inspired local Markdown viewer & editor for Windows",
  "scripts": {
    "start": "tauri dev",
    "vendor": "node scripts/copy-vditor.mjs",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write . && eslint --fix .",
    "dist": "tauri build"
  },
  "keywords": [
    "markdown",
    "editor",
    "tauri",
    "wysiwyg"
  ],
  "author": "yataome1 <zhangmian@outlook.com>",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "vditor": "3.11.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.4",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  }
}
